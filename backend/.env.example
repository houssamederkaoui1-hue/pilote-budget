# Copy to backend/.env to override defaults (all values shown are defaults).

PILOTE_APP_NAME="Pilote Budget API"
PILOTE_VERSION=0.1.0
PILOTE_ENVIRONMENT=development
PILOTE_DEBUG=false

# SQLite location (relative paths resolve against backend/)
PILOTE_DATABASE_URL=sqlite:///./data/pilote_budget.db

# Run Alembic migrations on startup (recommended)
PILOTE_AUTO_MIGRATE=true

PILOTE_API_PREFIX=/api/v1
PILOTE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Cloud deployment (Render) -------------------------------------------------
#
# When deploying, set these via the Render dashboard instead (never in a
# committed file). Managed Postgres also auto-injects a bare DATABASE_URL,
# which the backend honours as a fallback -- so on Render you only need:
#
#   DATABASE_URL          (auto-injected by Render)
#   PILOTE_ACCESS_TOKEN   (recommended: a long random string)
#   PILOTE_ENVIRONMENT    production
#
# Serving the built SPA from the API (default OFF locally for Vite dev):
#   PILOTE_SERVE_FRONTEND=true
#
# Optional: point PILOTE_DATABASE_URL at Postgres too (takes precedence over
# the bare DATABASE_URL above), e.g.
#   PILOTE_DATABASE_URL=postgresql://user:pass@host:5432/pilote?sslmode=require
#
# Postgres deployments build the schema from the models and stamp Alembic to
# head on startup. They never import your SQLite data automatically. To move
# data over, run the operator tool once (see DEPLOYMENT.md):
#
#   uv run python -m app.tools.import_sqlite --sqlite data/pilote_budget.db \
#       --target "$DATABASE_URL" --check
#   uv run python -m app.tools.import_sqlite --sqlite data/pilote_budget.db \
#       --target "$DATABASE_URL" --yes
