rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Identity helpers
    // ---------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // Every rule in this service is scoped to the authenticated caller's own
    // UID. There is no rule that grants access outside /users/{uid}.
    function own(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------
    // Shape helpers
    // ---------------------------------------------------------------
    function cents(v) {
      return v is int;
    }

    function centsNonNeg(v) {
      return cents(v) && v >= 0;
    }

    // Accessing a missing map key is an ERROR in the rules language, so every
    // optional field must be presence-tested first with `key in map`.
    function optionalString(d, key) {
      return !(key in d) || d[key] == null || d[key] is string;
    }

    function optionalInt(d, key) {
      return !(key in d) || d[key] == null || d[key] is int;
    }

    function optionalBool(d, key) {
      return !(key in d) || d[key] == null || d[key] is bool;
    }

    // True when a document is an operator-imported ledger row (`imported`
    // present and true). Presence is tested first because reading a missing
    // map key is a rules error. Used as a *stored-side* guard so a client can
    // neither edit an imported row nor clear its `imported` flag to escape
    // immutability.
    function isImported(d) {
      return ('imported' in d) && d.imported == true;
    }

    // ---------------------------------------------------------------
    // profile + settings (single documents, id "me")
    // ---------------------------------------------------------------
    match /users/{uid}/profile/{docId} {
      allow read, list: if own(uid);
      allow create, update: if own(uid) && docId == 'me'
        && request.resource.data.keys().hasOnly([
            'currency', 'monthStartDay', 'timezone', 'preferences'
          ])
        && request.resource.data.currency is string
        && request.resource.data.monthStartDay is int
        && request.resource.data.timezone is string
        && request.resource.data.preferences is map;
      allow delete: if own(uid);
    }

    match /users/{uid}/settings/{docId} {
      allow read, list: if own(uid);
      allow create, update: if own(uid) && docId == 'me'
        && request.resource.data.keys().hasOnly([
            'theme', 'hideSignedOut', 'onboardingStep', 'excludedAccounts'
          ])
        && request.resource.data.theme in ['light', 'dark']
        && optionalBool(request.resource.data, 'hideSignedOut')
        && optionalString(request.resource.data, 'onboardingStep');
      allow delete: if own(uid);
    }

    // ---------------------------------------------------------------
    // categories
    // ---------------------------------------------------------------
    match /users/{uid}/categories/{docId} {
      allow read, list: if own(uid);
      allow create, update: if own(uid)
        && request.resource.data.keys().hasOnly([
            'name', 'type', 'parentId', 'active', 'description'
          ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.type in ['income', 'expense']
        && optionalString(request.resource.data, 'parentId')
        && request.resource.data.active is bool
        && optionalString(request.resource.data, 'description');
      allow delete: if own(uid);
    }

    // ---------------------------------------------------------------
    // accounts  (money is integer cents)
    // ---------------------------------------------------------------
    match /users/{uid}/accounts/{docId} {
      allow read, list: if own(uid);
      allow create, update: if own(uid)
        && request.resource.data.keys().hasOnly([
            'name', 'type', 'openingBalanceCents', 'currentBalanceCents',
            'currency', 'active', 'description'
          ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.type in [
            'bank', 'checking', 'savings', 'cash', 'credit_card',
            'debit_card', 'investment', 'loan', 'other'
          ]
        && cents(request.resource.data.openingBalanceCents)
        && cents(request.resource.data.currentBalanceCents)
        && request.resource.data.currency is string
        && request.resource.data.active is bool
        && optionalString(request.resource.data, 'description');
      allow delete: if own(uid);
    }

    // ---------------------------------------------------------------
    // transactions
    // ---------------------------------------------------------------
    function isTransaction() {
      let d = request.resource.data;
      return d.keys().hasOnly([
            'accountId', 'categoryId', 'type', 'amountCents', 'date',
            'description', 'notes', 'status', 'importBatchId',
            'externalId', 'importMetadata', 'dedupeKey', 'imported'
          ])
        && d.type in ['income', 'expense', 'transfer']
        && d.status in ['pending', 'cleared', 'reconciled', 'void']
        && cents(d.amountCents)
        && d.date is string
        && d.accountId is string
        && optionalString(d, 'categoryId')
        && d.description is string
        && optionalString(d, 'notes')
        && optionalString(d, 'importBatchId')
        && optionalString(d, 'externalId')
        && optionalString(d, 'importMetadata')
        && optionalString(d, 'dedupeKey')
        && optionalBool(d, 'imported');
    }

    match /users/{uid}/transactions/{docId} {
      allow read, list: if own(uid);
      allow create: if own(uid) && isTransaction();
      // Imported rows are immutable. Two guards are required: the request-side
      // guard rejects an update that tries to *become* imported, and the
      // stored-side guard rejects edits/deletes of a row that already is
      // imported. Without the stored-side guard a client could send
      // `imported: false` and overwrite an operator-imported ledger row.
      allow update: if own(uid) && isTransaction()
        && !isImported(request.resource.data)
        && !isImported(resource.data);
      allow delete: if own(uid)
        && !isImported(resource.data);
    }

    // ---------------------------------------------------------------
    // transfers  (double-entry exists at the data layer only; the pairing
    // invariant cannot be encoded in rules — see plan §4 C-1)
    // ---------------------------------------------------------------
    function isTransfer() {
      let d = request.resource.data;
      return d.keys().hasOnly([
            'sourceAccountId', 'destinationAccountId', 'amountCents',
            'date', 'description', 'notes', 'status', 'imported'
          ])
        && d.sourceAccountId is string
        && d.destinationAccountId is string
        && d.amountCents > 0
        && d.status in ['pending', 'completed', 'cancelled']
        && d.date is string
        && d.description is string
        && optionalString(d, 'notes')
        && optionalBool(d, 'imported');
    }

    match /users/{uid}/transfers/{docId} {
      allow read, list: if own(uid);
      allow create: if own(uid) && isTransfer();
      // Imported rows are immutable. The request-side guard rejects an update
      // that tries to *become* imported; the stored-side guard rejects
      // edits/deletes of a row that already is imported (otherwise a client
      // could send `imported: false` and overwrite an operator-imported row).
      allow update: if own(uid) && isTransfer()
        && !isImported(request.resource.data)
        && !isImported(resource.data);
      allow delete: if own(uid)
        && !isImported(resource.data);
    }

    // ---------------------------------------------------------------
    // allocations (per-month budget envelope) and budgets (per category)
    // ---------------------------------------------------------------
    function isAllocation() {
      let d = request.resource.data;
      return d.keys().hasOnly([
            'monthId', 'incomeCents', 'needsCents', 'wantsCents',
            'savingsCents', 'otherCents'
          ])
        && d.monthId is string
        && cents(d.incomeCents)
        && cents(d.needsCents)
        && cents(d.wantsCents)
        && cents(d.savingsCents)
        && cents(d.otherCents);
    }

    match /users/{uid}/allocations/{docId} {
      allow read, list: if own(uid);
      allow create, update: if own(uid) && isAllocation();
      allow delete: if own(uid);
    }

    function isBudget() {
      let d = request.resource.data;
      return d.keys().hasOnly([
            'monthId', 'categoryId', 'plannedAmountCents', 'notes'
          ])
        && d.monthId is string
        && d.categoryId is string
        && cents(d.plannedAmountCents)
        && optionalString(d, 'notes');
    }

    match /users/{uid}/budgets/{docId} {
      allow read, list: if own(uid);
      allow create, update: if own(uid) && isBudget();
      allow delete: if own(uid);
    }

    // ---------------------------------------------------------------
    // goals / debts / recurring
    // ---------------------------------------------------------------
    function isGoal() {
      let d = request.resource.data;
      return d.keys().hasOnly([
            'name', 'targetAmountCents', 'currentAmountCents', 'targetDate',
            'accountId', 'active', 'notes'
          ])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 120
        && cents(d.targetAmountCents)
        && cents(d.currentAmountCents)
        && optionalString(d, 'targetDate')
        && d.accountId is string
        && d.active is bool
        && optionalString(d, 'notes');
    }

    match /users/{uid}/goals/{docId} {
      allow read, list: if own(uid);
      allow create, update: if own(uid) && isGoal();
      allow delete: if own(uid);
    }

    function isDebt() {
      let d = request.resource.data;
      return d.keys().hasOnly([
            'name', 'creditor', 'originalAmountCents', 'remainingAmountCents',
            'interestRateBps', 'minimumPaymentCents', 'dueDate', 'accountId',
            'active', 'notes'
          ])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 120
        && optionalString(d, 'creditor')
        && cents(d.originalAmountCents)
        && cents(d.remainingAmountCents)
        && optionalInt(d, 'interestRateBps')
        && optionalInt(d, 'minimumPaymentCents')
        && optionalString(d, 'dueDate')
        && d.accountId is string
        && d.active is bool
        && optionalString(d, 'notes');
    }

    match /users/{uid}/debts/{docId} {
      allow read, list: if own(uid);
      allow create, update: if own(uid) && isDebt();
      allow delete: if own(uid);
    }

    function isRecurring() {
      let d = request.resource.data;
      return d.keys().hasOnly([
            'accountId', 'categoryId', 'type', 'amountCents', 'frequency',
            'nextOccurrence', 'endDate', 'description', 'notes', 'active'
          ])
        && d.accountId is string
        && optionalString(d, 'categoryId')
        && d.type in ['income', 'expense']
        && cents(d.amountCents)
        && d.frequency in [
            'daily', 'weekly', 'biweekly', 'monthly',
            'quarterly', 'yearly', 'custom'
          ]
        && d.nextOccurrence is string
        && optionalString(d, 'endDate')
        && d.description is string
        && optionalString(d, 'notes')
        && d.active is bool;
    }

    match /users/{uid}/recurring/{docId} {
      allow read, list: if own(uid);
      allow create, update: if own(uid) && isRecurring();
      allow delete: if own(uid);
    }

    // ---------------------------------------------------------------
    // imports — operator/import bookkeeping; never deletable
    // ---------------------------------------------------------------
    match /users/{uid}/imports/{runId} {
      allow read, list: if own(uid);
      allow create, update: if own(uid)
        && request.resource.data.keys().hasOnly([
            'fingerprint', 'createdAt', 'importedCount'
          ])
        && request.resource.data.fingerprint is string
        && request.resource.data.createdAt is string
        && request.resource.data.importedCount is int;
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Explicit default: deny everything not matched above.
    // ---------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}