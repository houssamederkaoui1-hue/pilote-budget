# ---- Environment & secrets (never commit these) ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ecdsa
id_ed25519
.netrc
credentials
secrets.*
.secret_token

