# Build context is the repository root. Keep it lean and never ship secrets,
# local databases or caches.

# VCS
.git
.gitignore

# Python
backend/.venv
**/__pycache__
**/*.pyc
backend/.pytest_cache
backend/.ruff_cache
backend/data

# Node
frontend/node_modules
frontend/dist

# Local env / secrets
**/.env
**/.env.*
!backend/.env.example
*.key
*.pem

# Editors / OS
.vscode
.idea
.DS_Store
*.swp