# Public Firebase web config (from Console: Project settings → Your apps → Web).
# Safe to commit — this is NOT a service-account key. Firestore access is
# enforced by Security Rules using request.auth.uid.
#
# The /firebase/* read-only preview only activates when the three starred
# values are present. The legacy FastAPI app works with or without these.

VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef

# LOCAL-ONLY emulator switch. Leave unset/false for real projects and
# production builds. Set to `true` in an untracked `.env.local` to point the
# /firebase/* preview at the local Auth + Firestore emulators (see
# FIREBASE_SMOKE_TEST.md). Optional host override defaults to 127.0.0.1.
# VITE_FIREBASE_USE_EMULATORS=true
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1